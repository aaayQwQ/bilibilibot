[bilibili]
; 直播间号（短号或真实房间号均可）
room_id=0
; Cookie 不再写入此文件，请将 Get cookies.txt LOCALLY 导出的 Netscape 格式文件
; 放在本文件同目录，并命名为 cookie.txt。

[ai]
; 协议选择：openai 或 anthropic
; openai 使用 /v1/chat/completions；anthropic 使用 /v1/messages
protocol=anthropic
; API 根地址。可填写 https://api.example.com 或带 /v1 的地址
base_url=https://api.example.com
api_key=
model=
; true=启用思考：OpenAI 发送 reasoning_effort=medium；
; Anthropic 发送 thinking.type=adaptive（需服务商和模型支持）
thinking=false
max_tokens=512
system_prompt=你是一个直播间聊天助手。请用简短、自然、友好的中文回答观众的问题。回答适合直播弹幕，不要使用 Markdown，不要声称自己是主播。

[bot]
; 触发词以 | 分隔，任意一个命中即触发
keywords=@AI|@机器人
; 机器人每次回复的最大字符数
max_reply_chars=180
; 同一用户两次触发的最小间隔（秒）
user_cooldown_seconds=15
; 全房间两次回复的最小间隔（秒）
room_cooldown_seconds=3
; 是否允许机器人账号自己发送的普通弹幕触发关键词
reply_to_self=true
; 单个用户在内存中保留的对话轮数
memory_turns=4
